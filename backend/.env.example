# Server
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_crm

# JWT access token secret — MUST be a long random value in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Access token lifetime (short-lived; refreshed via httpOnly cookie)
JWT_EXPIRES_IN=15m

# Refresh token lifetime (stored hashed in the sessions table)
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-free single origin allowed in production (e.g. https://app.example.com)
CORS_ORIGIN=http://localhost:5173

# strict (default) | lax | none
# Use "none" when the API and frontend are on different registrable domains
# (e.g. API on *.onrender.com, frontend on a custom domain). Requires HTTPS.
COOKIE_SAME_SITE=strict

# development | production | test
NODE_ENV=development
